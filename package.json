{
  "name": "read-taiwan-committee",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "check-data": "tsx scripts/check-data.ts",
    "fetch-data": "tsx scripts/fetch-data.ts",
    "build": "npm run check-data && astro build && pagefind --site dist",
    "preview": "astro preview",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "astro check && tsc -p apps-script/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:apps-script": "tsx scripts/build-apps-script.ts",
    "fetch-demo": "tsx scripts/fetch-demo.ts"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/google-apps-script": "^2.0.13",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "pagefind": "^1.5.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
